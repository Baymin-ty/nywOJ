{
  "DB": {
    "host": "localhost",
    "port": 3306,
    "username": "root",
    "password": "<your-mysql-password>",
    "databasename": "nywoj"
  },
  "EMAIL": {
    "host": "smtp.163.com",
    "port": 465,
    "secure": true,
    "username": "<your-smtp-user>@163.com",
    "password": "<your-smtp-auth-code>",
    "from": "nywOJ <your-smtp-user@163.com>"
  },
  "SESSION": {
    "secret": "<replace-with-a-long-random-secret>",
    "expire": "604800000"
  },
  "HTTP": {
    "bodyLimit": "64mb"
  },
  "preference": {
    "security": {
      "recaptchaEnabled": false,
      "recaptchaKey": "",
      "requireEmailVerification": true,
      "allowUserChangeUsername": true,
      "allowEveryoneCreateProblem": true,
      "allowNonPrivilegedUserEditPublicProblem": true,
      "allowOwnerManageProblemPermission": false,
      "allowOwnerDeleteProblem": true,
      "allowEveryoneCreateDiscussion": true,
      "discussionDefaultPublic": true,
      "discussionReplyDefaultPublic": true
    },
    "pagination": {
      "homepageUserList": 10,
      "homepageProblemList": 10,
      "problemSet": 50,
      "searchProblemsPreview": 7,
      "submissions": 10,
      "submissionStatistics": 10,
      "userList": 30,
      "userAuditLogs": 10,
      "discussions": 10,
      "searchDiscussionsPreview": 7,
      "discussionReplies": 40,
      "discussionRepliesHead": 20,
      "discussionRepliesMore": 20
    },
    "misc": {
      "appLogo": "default",
      "appLogoForTheme": {
        "pure": "original",
        "far": "inverted"
      },
      "googleAnalyticsId": null,
      "plausibleApiEndpoint": null,
      "gravatarCdn": "https://gravatar.com",
      "redirectOldUrls": true,
      "contestsEntryUrl": null,
      "homepageUserListOnMainView": true,
      "sortUserByRating": false,
      "renderMarkdownInUserBio": false,
      "discussionReactionEmojis": ["👍", "👎", "😄", "😕", "❤️", "🤔", "🤣", "🌿", "🍋", "🕊️"],
      "discussionReactionAllowCustomEmojis": true
    }
  },
  "queryLimit": {
    "problemSet": 100,
    "submissions": 10,
    "submissionStatistics": 10,
    "searchUser": 10,
    "searchGroup": 10,
    "userList": 100,
    "userAuditLogs": 20,
    "discussions": 20,
    "discussionReplies": 50
  },
  "METRICS": {
    "enabled": false,
    "hostname": "127.0.0.1",
    "port": 9100,
    "allowedIps": ["127.0.0.1", "::1"]
  },
  "EVENT_REPORT": {
    "enabled": false,
    "siteName": "nywOJ",
    "telegramBotToken": "",
    "sentTo": "",
    "telegramApiRoot": "https://api.telegram.org",
    "proxyUrl": "",
    "timeout": 8000,
    "dedupeWindowMs": 60000
  },
  "LLM": {
    "baseUrl": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "timeout": 120000,
    "maxTokens": 20000
  },
  "SECURITY": {
    "enabled": true,
    "abuseAuditThreshold": 20,
    "rules": {
      "submit": { "capacity": 2, "refillPerSec": 0.1 },
      "customRun": { "capacity": 6, "refillPerSec": 0.1 },
      "login": { "capacity": 10, "refillPerSec": 0.167 },
      "post": { "capacity": 5, "refillPerSec": 0.083 },
      "search": { "capacity": 30, "refillPerSec": 0.5 }
    }
  },
  "JUDGE": {
    "ISSERVER": true,
    "NAME": "<judge-machine-name>",
    "CLIENT_KEY": "",
    "CLIENT_TIMEOUT": 10000,
    "ALLOW_REMOTE_SANDBOX_CLIENTS": false
  },
  "SANDBOX": {
    "url": "http://127.0.0.1:5050",
    "streamUrl": "ws://127.0.0.1:5050/api/stream"
  },
  "STORAGE": {
    "provider": "local",
    "localRoot": ".",
    "problemArchivePrefix": "problem-data",
    "SIGN_SECRET": "<change-this-storage-signing-secret>",
    "SIGNED_URL_TTL": 900,
    "s3": {
      "endpoint": "https://s3.example.com",
      "region": "us-east-1",
      "bucket": "nywoj",
      "prefix": "oj",
      "accessKeyId": "<s3-access-key>",
      "secretAccessKey": "<s3-secret-key>",
      "forcePathStyle": true
    }
  },
  "SYNC": {
    "remote": "root@<deploy-host>",
    "remoteDataDir": "/root/nywoj/server/data",
    "comment": "Used by sync_data.sh to rsync test cases from the deploy server. The script reads SYNC.remote / SYNC.remoteDataDir if jq is available, otherwise falls back to env vars NYWOJ_SYNC_REMOTE / NYWOJ_SYNC_REMOTE_DIR."
  }
}
